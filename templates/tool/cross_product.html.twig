{% extends 'base.html.twig' %}

{% block title %}{{ 'tool.cross_product.title'|trans }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block importmap %}
        {{ importmap('app') }}
        {{ importmap('cross-product-calculator') }}
    {% endblock %}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">{{ 'tool.cross_product.title'|trans }}</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted">{{ 'tool.cross_product.subtitle'|trans }}</p>

                    <div id="crossProductForm">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="valueA" class="form-label">{{ 'tool.cross_product.value_a'|trans }}</label>
                                <input type="number" step="any" class="form-control" id="valueA" placeholder="{{ 'tool.cross_product.placeholder_a'|trans }}">
                            </div>
                            <div class="col-md-6">
                                <label for="valueB" class="form-label">{{ 'tool.cross_product.value_b'|trans }}</label>
                                <input type="number" step="any" class="form-control" id="valueB" placeholder="{{ 'tool.cross_product.placeholder_b'|trans }}">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="valueC" class="form-label">{{ 'tool.cross_product.value_c'|trans }}</label>
                                <input type="number" step="any" class="form-control" id="valueC" placeholder="{{ 'tool.cross_product.placeholder_c'|trans }}">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">{{ 'tool.cross_product.result_x'|trans }}</label>
                                <input type="text" class="form-control bg-light" id="resultX" placeholder="{{ 'tool.cross_product.result_placeholder'|trans }}" readonly>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="button" class="btn btn-secondary" id="resetBtn">{{ 'tool.cross_product.reset'|trans }}</button>
                        </div>
                    </div>

                    <div class="mt-4 alert alert-info">
                        <strong>{{ 'tool.cross_product.formula'|trans }}:</strong> {{ 'tool.cross_product.formula_text'|trans }}
                    </div>

                    <div id="errorMessage" class="mt-3 alert alert-danger d-none"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
