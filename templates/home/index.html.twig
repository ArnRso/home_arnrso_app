{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h1 class="card-title">{{ 'home.welcome'|trans }}</h1>
                    <p class="card-text">{{ 'home.logged_in_as'|trans }} {{ app.user.userIdentifier }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
